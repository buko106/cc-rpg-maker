    },
    {
      "path": "../../packages/audio-webaudio"
    },
    {
      "path": "../../packages/audio-null"
    },
    {
      "path": "../../packages/input-browser"
    },
    {
      "path": "../../packages/input-script"
    },
    {
      "path": "../../packages/assets"
    },
    {
      "path": "../../packages/project-store"
    },
    {
      "path": "../../packages/save-store"
    },
    {
      "path": "../../packages/exporter"
    },
    {
      "path": "../../packages/schema"
