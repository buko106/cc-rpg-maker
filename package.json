{
  "name": "cc-rpg-maker",
  "private": true,
  "version": "0.0.0",
  "description": "ブラウザで動く RPGツクール風のゲーム制作ツール",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs && node tools/check-manifests.mjs",
    "clean": "tsc -b --clean",
    "test:coverage": "vitest run --coverage",
    "demo": "node apps/player/scripts/build-web.mjs --project fixtures/projects/v1/demo && node tools/serve-static.mjs apps/player/dist-web 4173"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
