{
  "name": "cc-rpg-maker",
  "private": true,
  "version": "0.0.0",
  "description": "ブラウザで動く RPGツクール風のゲーム制作ツール",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint:deps": "depcruise packages plugins apps --config .dependency-cruiser.cjs && node tools/check-manifests.mjs",
    "clean": "tsc -b --clean",
    "test:coverage": "vitest run --coverage",
    "demo": "node tools/build-demos.mjs && node tools/serve-static.mjs apps/player/dist-demos 4173",
    "build:site": "node tools/build-site.mjs",
    "site": "pnpm build:site && node tools/serve-static.mjs site-dist 4175",
    "editor": "node apps/editor-ui/scripts/build-web.mjs && node tools/serve-static.mjs apps/editor-ui/dist-web 4174"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.4.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
