              "code": "ShowText",
              "params": {
                "text": "つかまった 回数は \\V[var_caught]回 じゃな。\n奥の 戸から 一の間へ 行けるぞ。",
                "position": "bottom",
                "background": "window"
              },
              "indent": 0
            }
          ]
