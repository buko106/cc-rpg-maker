          "trigger": "action",
          "through": false,
          "priority": "same",
          "commands": [
            {
              "code": "ShowText",
              "params": {
                "text": "おお、宝を 持ち帰ったか！\n\\C[6]一人前の冒険者じゃ\\C[0]。",
                "position": "bottom",
                "background": "window"
              },
              "indent": 0
